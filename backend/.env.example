# ==========================================
# RYTHEME NODE.JS BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------
# 1. SUPABASE CREDENTIALS
# ------------------------------------------
# Get these from https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional: Service Role Key for admin overrides (keep secure, never share publicly)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# 2. JIOSAAVN OPEN-SOURCE API CONFIG
# ------------------------------------------
# Public Open-Source JioSaavn endpoint (Default: https://saavn.dev)
# GitHub: https://github.com/sumitkolhe/jiosaavn-api
JIOSAAVN_API_URL=https://saavn.dev

# Optional: API Key if using a private proxy, self-hosted API, or RapidAPI
JIOSAAVN_API_KEY=

# Optional: RapidAPI Host header (if using RapidAPI JioSaavn endpoint)
JIOSAAVN_RAPIDAPI_HOST=

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=8000
